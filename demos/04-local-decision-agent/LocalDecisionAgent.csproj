<!-- Purpose: Run the same pinned decision logic locally without the hosting SDK. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageReference Include="ElBruno.AI.Decisions.Foundry" Version="0.6.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\05-foundry-hosted-decision-agent\src\SupportRoutingAgent\SupportRoutingAgent.cs" Link="SupportRoutingAgent.cs" />
    <ProjectReference Include="..\05-foundry-hosted-decision-agent\src\SupportRouting.Contracts\SupportRouting.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\DemoSettings.cs" Link="DemoSettings.cs" />
    <None Include="..\shared\demo-settings.local.json" Link="demo-settings.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('..\shared\demo-settings.local.json')" />
  </ItemGroup>
</Project>
