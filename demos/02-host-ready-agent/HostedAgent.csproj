<!-- Purpose: Expose the same agent through Foundry Responses protocol v2.0. -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.27.0-preview.261030.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\DemoSettings.cs" Link="DemoSettings.cs" />
    <None Include="..\shared\demo-settings.local.json" Link="demo-settings.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('..\shared\demo-settings.local.json')" />
  </ItemGroup>
</Project>
